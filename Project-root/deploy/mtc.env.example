# ─────────────────────────────────────────────────────────────────────────
# MTC ERP — systemd EnvironmentFile
#
# Install to /etc/mtc/mtc.env, owned root:mtc, mode 0640. It is read by
# systemd, NOT by python-dotenv: keep it to KEY=value with no `export`, no
# quotes around values (systemd keeps them literally) and no inline comments
# after a value.
#
# Do NOT also place a .env inside the checkout. config.py calls
# load_dotenv(override=True), so a stray .env would silently OVERRIDE
# everything set here and you would be debugging the wrong file.
# ─────────────────────────────────────────────────────────────────────────

FLASK_ENV=production

# 64 hex chars: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# ── URL and TLS ──────────────────────────────────────────────────────────
# BASE_URL's SCHEME is load-bearing, not cosmetic. https:// turns on
# force_https, HSTS and Secure session cookies; http:// turns all three off
# so a LAN deployment can log in at all. Set it to what browsers actually
# type, including the port if non-standard.
BASE_URL=https://mtc.example.com

# ── Behind nginx: REQUIRED ───────────────────────────────────────────────
# Without this the app trusts no proxy header, so every request appears to
# come from 127.0.0.1 over http. Two things break, both silently:
#   1. The rate limiter keys on remote_addr, so ALL users share one bucket
#      and collectively get RATELIMIT_DEFAULT (200/day) before 429s begin.
#   2. url_for(_external=True) emits http:// URLs, so Google rejects the
#      OAuth redirect_uri and login fails.
PROXY_FIX=x_for=1,x_proto=1

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mtc:CHANGE_ME@127.0.0.1:5432/mtc

# The pool is per WORKER PROCESS, so the ceiling is WEB_CONCURRENCY ×
# DB_POOL_MAX and it must stay under Postgres' max_connections. At the
# default 20 with 9 workers that is 180 against a stock limit of 100, which
# surfaces as "too many connections" and reads like a database fault.
#
# 6 is measured, not guessed: instrumenting every get_conn() across the ERP
# test suite (8,158 acquisitions) showed a maximum of 3 held at once by any
# one path, plus the audit and backup threads sharing the process.
DB_POOL_MAX=6
# Steady-state connection count is DB_POOL_MIN × workers -- psycopg2 keeps
# only minconn idle and closes the rest on return -- so this, not
# DB_POOL_MAX, is the number that costs memory.
DB_POOL_MIN=2

# ── Redis: a hard boot dependency in production ──────────────────────────
# create_app() raises RuntimeError if this is unreachable when FLASK_ENV
# =production. There is no in-memory fallback outside development.
RATELIMIT_STORAGE_URL=redis://127.0.0.1:6379/0

# ── Google OAuth ─────────────────────────────────────────────────────────
# Required for boot even when unused: _load_config() lists both as mandatory
# and an empty value aborts startup. On a LAN deployment Google Sign-In
# cannot work at all (Google rejects private-IP redirect URIs), so use
# placeholders there and log in with email + password.
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ── Gunicorn ─────────────────────────────────────────────────────────────
# (2 × cores) + 1. Sync workers: this IS your concurrency limit, and one PDF
# export holds a worker for its whole render (~0.66 s per document).
WEB_CONCURRENCY=9

# ── Email (optional) ─────────────────────────────────────────────────────
# Unset means password-reset links are written to the log instead of sent.
#MAIL_SERVER=in-v3.mailjet.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_DEFAULT_SENDER=

# ── Google Sheets backup (optional) ──────────────────────────────────────
# Needs internet. Without it the nightly local SQL dump still runs, and the
# dashboard reports the run as PARTIAL rather than SUCCESS -- that PARTIAL
# means "the snapshot is fine, the Sheets exports are switched off".
#
# The key must be readable by the app user: install it root:mtc 0640 into
# /etc/mtc, which provision.sh already creates 0750 root:mtc.
#   install -m 0640 -o root -g mtc gcp-key.json /etc/mtc/gcp-key.json
#GOOGLE_APPLICATION_CREDENTIALS=/etc/mtc/gcp-key.json
#
# Where the dated backup spreadsheet lives. Set BACKUP_SPREADSHEET_ID to a
# spreadsheet you created and shared with the service account as Editor --
# that is the normal case. Leave it unset ONLY if you want a brand new
# "MTC-backup-<date>" spreadsheet per run, in which case DRIVE_FOLDER_ID
# must name a folder shared with the service account, or the file is owned
# by the service account and nobody else can open it.
#DRIVE_FOLDER_ID=
#BACKUP_SPREADSHEET_ID=
#
# The legacy Apps Script app's own spreadsheet, mirrored in its original
# per-sheet layout. A DIFFERENT, fixed destination from the dated backup
# above -- do not point both at the same file. Unset means the mirror phase
# is skipped and every run reports PARTIAL even when the Sheets sync works.
# backup_service.py falls back to BACKUP_SPREADSHEET_ID when this is unset,
# which writes the GAS layout over the dated backup; set it explicitly.
#GAS_MIRROR_SPREADSHEET_ID=
