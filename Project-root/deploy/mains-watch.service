# Mains-failure watchdog for the MTC ERP server.
#
# Install to /etc/systemd/system/mains-watch.service.
#
# Detects mains failure by watching whether the modem (the default gateway)
# still answers, takes an immediate snapshot, then shuts the machine down
# cleanly while the inverter still has charge. deploy/mains-watch.sh explains
# why the modem is the sensor and why "gateway down" is not the same event as
# "internet down".
#
# ARMING IT IS A SEPARATE, DELIBERATE STEP. As shipped it only reports what it
# would have done, because a bug in a service that can power off a production
# server should cost a journal line, not a working day:
#
#   sudo systemctl edit mains-watch          # add the override below
#     [Service]
#     Environment=MAINS_WATCH_ENABLE=1
#   sudo systemctl restart mains-watch
#
# Watch it:  journalctl -t mtc-mains -f

[Unit]
Description=MTC mains-failure watchdog (snapshot then clean shutdown)
Documentation=file:///opt/mtc/src/Project-root/deploy/POWER_OUTAGE_RESILIENCE.md
After=network-online.target mtc.service
Wants=network-online.target

[Service]
Type=simple
# Root, and deliberately so: it has to run `systemctl poweroff`. It drops to
# the mtc user for the snapshot itself (see snapshot_now in the script), so
# the dump is not left root-owned in backups/ where the nightly job's
# retention could no longer delete it.
User=root

# Report-only until someone overrides this. See the header.
Environment=MAINS_WATCH_ENABLE=0

# 4 misses x 5s = 20s of continuous silence before acting, then a 3-second
# confirmation burst. The budget being spent is the ~2 minutes the server
# outlived the modem during the last real outage.
Environment=MAINS_WATCH_POLL=5
Environment=MAINS_WATCH_THRESHOLD=4
Environment=MAINS_WATCH_CONFIRM=3

Environment=PYTHONUNBUFFERED=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8

ExecStart=/bin/bash /opt/mtc/src/Project-root/deploy/mains-watch.sh

# It exits 0 after acting on a real outage, and systemd must not then start it
# again during the shutdown it just asked for. on-failure covers the crash
# case without fighting the poweroff.
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mtc-mains

[Install]
WantedBy=multi-user.target
