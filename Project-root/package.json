{
  "name": "mtc-frontend-tests",
  "version": "1.0.0",
  "description": "Frontend JavaScript tests for MTC application",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint static/erp",
    "lint:css": "stylelint \"static/erp/**/*.css\"",
    "verify": "npm run lint && npm run lint:css && npm test"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/static/erp/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "static/erp/**/*.js",
      "!static/erp/tests/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.8",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "htm": "^3.1.1",
    "jest": "^29.7.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "puppeteer-core": "^25.5.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "private": true
}
