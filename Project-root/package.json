{
  "name": "mtc-frontend-tests",
  "version": "1.0.0",
  "description": "Frontend JavaScript tests for MTC application",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/static/erp/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "static/erp/**/*.js",
      "!static/erp/tests/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "private": true
}
