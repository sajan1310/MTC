# Flask App Configuration
# -------------------------
# Generate a secret key using: python -c 'import secrets; print(secrets.token_hex(16))'
SECRET_KEY="your_super_secret_key"
FLASK_ENV="development"  # Can be "development" or "production"

# Database Configuration
# ----------------------
DB_HOST="localhost"
DB_NAME="MTC"
DB_USER="postgres"
DB_PASS="your_database_password"

# Dedicated database for the test suite. Must be different from DB_NAME above —
# the test suite runs schema migrations and seeds/deletes data against this DB.
TEST_DB_NAME="testdb"

# Google OAuth Configuration
# --------------------------
# IMPORTANT: The redirect URI must match EXACTLY what you configure in Google Cloud Console
#
# Setup Instructions:
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Application type: Web application)
# 3. Under "Authorized redirect URIs", add the EXACT URL shown when you run:
#    python check_oauth_config.py
# 4. For local development, use: http://127.0.0.1:5000/auth/google/callback
# 5. For production, use: https://yourdomain.com/auth/google/callback
#
# ⚠️  The callback path must be: /auth/google/callback (not /auth/callback)
# ⚠️  Protocol (http/https), port, and path must match EXACTLY
#
# Copy your credentials here:
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Base URL (must match where your app is accessible)
# Development: http://127.0.0.1:5000
# Production: https://yourdomain.com
BASE_URL="http://127.0.0.1:5000"

# Full Postgres connection string, used in preference to DB_HOST/DB_NAME/
# DB_USER/DB_PASS above when set (e.g. required by docker-compose.yml).
DATABASE_URL=""

# Rate limiter storage backend (Redis). docker-compose.yml points this at
# the bundled redis service; falls back to memory:// automatically in dev.
RATELIMIT_STORAGE_URL="redis://localhost:6379/0"

# Outbound email (password-reset links). Leave MAIL_SERVER unset to run
# without email delivery -- the reset link is logged server-side instead,
# and (dev/testing only) returned directly in the API response so the flow
# stays testable without SMTP. Required for real users to receive reset
# emails in production.
# Example (Gmail, using an App Password, not your normal password):
#   MAIL_SERVER="smtp.gmail.com"
#   MAIL_PORT=587
#   MAIL_USE_TLS=true
#   MAIL_USERNAME="you@gmail.com"
#   MAIL_PASSWORD="your_app_password"
#   MAIL_DEFAULT_SENDER="you@gmail.com"
MAIL_SERVER=""
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_DEFAULT_SENDER=""

# ── Metrics (OBS-002) ────────────────────────────────────────────────────
# Bearer token for GET /metrics. Leave unset and the endpoint answers only an
# admin session; set it so a Prometheus scraper needs no login. Anything
# without a valid token gets a 404, not a 401.
#   METRICS_TOKEN=$(python -c "import secrets; print(secrets.token_urlsafe(32))")
METRICS_TOKEN=

# ── Assets (PERF-007) ────────────────────────────────────────────────────
# Overrides the ?v= cache-busting token, which otherwise derives from the
# newest mtime under static/. Set this for multi-machine deployments, where
# separate checkouts give identical files different mtimes per host.
# ASSET_VERSION=

# ── Backups (DEPLOY-001) ─────────────────────────────────────────────────
# Where snapshots are written. Unset keeps the historical behaviour (a
# backups/ directory beside the checkout), which is correct for the systemd
# deployment. The container image sets this itself.
# BACKUP_DIR=

# ── Activity log (AUDIT-001) ─────────────────────────────────────────────
# How long erp.activity_log rows are kept, in days. Pruned by the nightly
# job in backup_service.py. Longer than erp.rpc_mutations' 7 days on
# purpose: that table answers "did this retry already run", this one
# answers "who changed this in March".
# ACTIVITY_LOG_RETENTION_DAYS=90

# ── Login throttle (SEC-009) ─────────────────────────────────────────────
# Per-ACCOUNT limit on FAILED logins, in addition to the per-IP limit.
# Successful sign-ins never consume it.
# RATELIMIT_LOGIN_PER_ACCOUNT=10 per 15 minutes
