# Environment variables
.env
*.env
*.env.local
!*.env.example
!production.env.example

# Cloud credentials — never commit (service-account keys, etc.)
gcp-key.json
*service-account*.json
*-key.json
credentials.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
venv*/
# '.venv' does not match 'venv*' -- the leading dot puts it outside that
# glob, so it was untracked but NOT ignored and a 'git add .' would have
# staged ~300 MB of it.
.venv/
*.egg-info/
dist/
build/

# Logs — never commit application logs
logs/
*.log
*.log.*
tmp_logs_test/

# Backups and database dumps — never commit
backups/
*.sql.bak
db_backup_*.sql
code_snapshot_*.zip

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Generated reports and artifacts
*_audit_report.json
audit_report.json
file_structure.txt

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
